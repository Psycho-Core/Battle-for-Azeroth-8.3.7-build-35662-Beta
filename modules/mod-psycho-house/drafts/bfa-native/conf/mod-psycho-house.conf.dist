###################################################################################################
#   mod-psycho-house - draft B, built only from what 8.3.7 build 35662 already has
#
#   Copy the keys that matter into worldserver.conf. Every key is optional.
#
#   This draft carries no retail ids at all. The decor catalogue is 350 game objects that
#   already exist in my source tree as named constants, the vendors are my own eight
#   stalls, and every price is gold. It is the version that runs on a clean 8.3.7 client
#   with no imported art and no retail item ids.
###################################################################################################

#   Housing.Enable
#       Description: Enable the player housing module.
#       Default:     0 (disabled) - 1 (enabled)

Housing.Enable = 0

#   Housing.Map.Mode
#       Description: "native" expects the housing map to exist in Map.db2. "anchor" runs on
#                    an existing map with hand-placed plot anchors. A fresh 8.3.7 install
#                    has no housing map, so this draft defaults to "anchor".
#       Default:     "anchor"

Housing.Map.Mode = "anchor"

#   Housing.Map.Id
#       Description: Map id used by the module. In "anchor" mode this is any existing map
#                    with room for 55 yard anchors; Elwynn Forest (0) works.
#       Default:     0

Housing.Map.Id = 0

#   Housing.Interior.Map
#       Description: Map id used for house interiors. In "anchor" mode leave this at 0 so
#                    interiors reuse the same map.
#       Default:     0

Housing.Interior.Map = 0

#   Housing.Interior.X / .Y / .Z / .O
#       Description: Interior anchor for the shared house shell.
#       Default:     0.0

Housing.Interior.X = 0.0
Housing.Interior.Y = 0.0
Housing.Interior.Z = 0.0
Housing.Interior.O = 0.0

#   Housing.TownCenter.X / .Y / .Z / .O
#       Description: Town Center landing point. 0/0 disables the "leave" teleport.
#       Default:     0.0

Housing.TownCenter.X = 0.0
Housing.TownCenter.Y = 0.0
Housing.TownCenter.Z = 0.0
Housing.TownCenter.O = 0.0

#   Housing.Evict.Days
#       Description: Days a house may go without an edit before it goes back on the market.
#                    0 turns eviction off, which is the default: a house that disappears
#                    because the owner took a break is the loudest bug report there is.
#       Default:     0 (off)

Housing.Evict.Days = 0

#   Housing.Evict.GraceDays
#       Description: Part of the window above spent as a warning rather than a deadline. The
#                    owner gets a letter when the grace period starts and loses the plot when
#                    it ends. Everything in the house goes to the archive, restorable for a fee.
#       Default:     7

Housing.Evict.GraceDays = 7

#   Housing.Neighborhood.PopulationCap
#       Description: Residents a neighbourhood may hold, counted by owned plots. 0 = as many
#                    as there are plots. Guild and private neighbourhoods count the same way.
#       Default:     0

Housing.Neighborhood.PopulationCap = 0

#   Housing.Phasing.PlotScoped
#       Description: Hide a plot's yard decor unless a player stands in that plot.
#       Default:     1

Housing.Phasing.PlotScoped = 1

#   Housing.PetBed.IndoorCap
#       Description: Beds allowed indoors per house. Retail's number is 100. 0 turns the cap
#                    off, which is what a realm with three bed models probably wants.
#       Default:     100

Housing.PetBed.IndoorCap = 100

#   Housing.PetBed.OutdoorCap
#       Description: Beds allowed outdoors per plot. Retail's number is 25. 0 turns the cap
#                    off.
#       Default:     25

Housing.PetBed.OutdoorCap = 25


#   Housing.SaveInterval
#       Description: Seconds between deferred decor and name writes.
#       Default:     30

Housing.SaveInterval = 30

#   Housing.RateLimit.Messages
#       Description: Addon messages accepted per ten second window, per player.
#       Default:     20

Housing.RateLimit.Messages = 20

#   Housing.Homestone.Cooldown
#       Description: Homestone teleport cooldown in seconds. Retail value is 900.
#       Default:     900

Housing.Homestone.Cooldown = 900

#   Housing.Sell.RefundPercent
#       Description: Percentage of the plot price refunded when a plot is sold.
#       Default:     50

Housing.Sell.RefundPercent = 50

Housing.Sell.RefundPercent = 50

#   Housing.Gryphon.Cost
#       Description: Gold the Steward charges to fly a player to their own door. 0 is free.
#       Default:     5

Housing.Gryphon.Cost = 5

#   Housing.Gryphon.Cooldown
#       Description: Seconds between gryphon rides, per account. 0 removes the wait.
#       Default:     300

Housing.Gryphon.Cooldown = 300

#   Housing.Plot.CornerstoneEntry
#       Description: gameobject entry spawned on every free plot, so the plot can be bought by
#                    clicking it. The entry must exist in gameobject_template and carry the
#                    ScriptName `go_housing_cornerstone`. 0 spawns nothing and plots are bought
#                    from the addon or the Steward instead.
#       Default:     0

Housing.Plot.CornerstoneEntry = 0

###################################################################################################
#   Neighbourhoods
###################################################################################################

#   Housing.Neighborhood.MinResidents
#       Description: A private or guild neighbourhood with fewer residents than this and no
#                    owned plots is dissolved once the grace period has passed. 0 turns the
#                    sweep off, which is the safe default: an empty street may be one somebody
#                    is about to move into.
#       Default:     0

Housing.Neighborhood.MinResidents = 0

#   Housing.Neighborhood.DissolveGraceDays
#       Description: Days an empty neighbourhood is left standing before it is dissolved.
#       Default:     30

Housing.Neighborhood.DissolveGraceDays = 30

#   Housing.Guild.Wings
#       Description: Give a guild that outgrows one neighbourhood an extra wing instead of
#                    turning members away. Only applies to guild neighbourhoods.
#       Default:     1

Housing.Guild.Wings = 1

###################################################################################################
#   The two level devices and the weekly cache
###################################################################################################

#   Housing.Arcanostorage.Level
#       Description: House level needed before the Arcanostorage Sphere will turn.
#       Default:     10

Housing.Arcanostorage.Level = 10

#   Housing.Arcanostorage.CooldownDays
#       Description: Days between turns of the Sphere, per account.
#       Default:     7

Housing.Arcanostorage.CooldownDays = 7

#   Housing.Armillary.Level
#       Description: House level needed before the Hearthlight Armillary can be lit.
#       Default:     6

Housing.Armillary.Level = 6

###################################################################################################
#   Numbers that live in the database, not here, so they can be changed without a restart:
#
#     housing_house_level   levels 1-12, XP thresholds, indoor / room / outdoor budgets
#     housing_shell         exteriors, sizes, level requirement, faction
#     housing_room          rooms, shell, level requirement, budget cost
#     housing_plot          plot prices, sizes, yard radius
#     housing_vendor_stock  prices, currency, Endeavor milestone gating
###################################################################################################
